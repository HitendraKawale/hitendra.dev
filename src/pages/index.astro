---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectIndex from "../components/ProjectIndex.astro";
import BlogCard from "../components/BlogCard.astro";
import Marquee from "../components/Marquee.astro";
import Brand from "../components/Brand.astro";
import { projects } from "../data/projects";
import { profile } from "../data/profile";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const featured = projects.filter(p => p.featured);
const [first, last] = profile.name.split(" ");

// Every tongue he carries, in his own scripts.
const tongues = [
  { word: "Hello",     lang: "English",   note: "Fluent" },
  { word: "Hola",      lang: "Español",   note: "Fluent" },
  { word: "你好",       lang: "中文",      note: "Conversational" },
  { word: "नमस्ते",      lang: "हिंदी",       note: "Mother tongue" },
  { word: "नमस्कार",     lang: "मराठी",      note: "Mother tongue" },
  { word: "こんにちは",   lang: "日本語",     note: "Basics" },
  { word: "Hallo",     lang: "Deutsch",   note: "Basics" },
  { word: "Hei",       lang: "Norsk",     note: "Basics" },
];
---

<BaseLayout
  title={`${profile.name} — ${profile.title}`}
  description={profile.bio}
  cardDescription={profile.cardBio}
>

  <!-- ════ CHAPTER I — THE STRUGGLER ════════════════════════ -->
  <section class="hero" data-hero>
    <div class="eclipse" aria-hidden="true">
      <span class="ecl-ring"></span>
      <span class="ecl-vortex"></span>
      <span class="ecl-core"></span>
    </div>

    <div class="wrap hero-inner">
      <div class="chapter-cap" data-reveal="rise">
        <Brand size={13} />
        <span class="label label-blood">Chapter I — The Struggler</span>
        <span class="rule"></span>
        <span class="label label-ash">Est. Pune → Surrey</span>
      </div>

      <h1 class="name">
        <span class="name-line" data-reveal="wipe"><span class="name-in">{first}</span></span>
        <span class="name-line name-line-2" data-reveal="wipe" style="--d:130ms">
          <span class="name-in">{last}</span>
        </span>
      </h1>

      <div class="hero-foot">
        <div class="hf-col" data-reveal="rise" style="--d:280ms">
          <span class="label label-ash">[ Discipline ]</span>
          <p class="hf-role">{profile.title}</p>
          <p class="hf-sub">MSc Artificial Intelligence — University of Surrey</p>
          <span class="status">
            <span class="status-dot"></span>
            {profile.availability}
          </span>
        </div>

        <div class="hf-col hf-lede" data-reveal="rise" style="--d:380ms">
          <span class="label label-ash">[ Prologue ]</span>
          <p>
            I build production-grade AI systems — LLM platforms, RAG pipelines, and
            interactive 3D vision. Backend-heavy, deployment-aware, and obsessed with
            what survives contact with real users.
          </p>
          <p class="hf-quote">
            "If you're a struggler — struggle, endure, contend."
            <span class="hf-cite">The Skull Knight</span>
          </p>
        </div>

        <div class="hf-col hf-links" data-reveal="rise" style="--d:480ms">
          <span class="label label-ash">[ Ways in ]</span>
          <a href={profile.resume} download="Hitendra-Kawale-Resume.pdf" class="way way-lead">
            Resume <span aria-hidden="true">↓</span>
          </a>
          <a href={profile.github} target="_blank" rel="noreferrer" class="way">
            GitHub <span aria-hidden="true">↗</span>
          </a>
          {profile.codeberg && (
            <a href={profile.codeberg} target="_blank" rel="noreferrer" class="way">
              Codeberg <span aria-hidden="true">↗</span>
            </a>
          )}
          {profile.linkedin && (
            <a href={profile.linkedin} target="_blank" rel="noreferrer" class="way">
              LinkedIn <span aria-hidden="true">↗</span>
            </a>
          )}
          <a href="/contact" class="way">Send word <span aria-hidden="true">→</span></a>
          <a href="/tldr" class="way way-quiet">In a hurry — TL;DR <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>

    <span class="descend" aria-hidden="true">
      <span class="descend-text">Descend</span>
      <span class="descend-line"></span>
    </span>
  </section>

  <!-- ════ ARSENAL ══════════════════════════════════════════ -->
  <Marquee items={profile.skills} />

  <!-- ════ CHAPTER II — DEEDS ═══════════════════════════════ -->
  <section class="act">
    <div class="wrap">
      <header class="chapter" data-reveal="rise">
        <span class="numeral">II</span>
        <h2 class="chapter-title">Deeds</h2>
        <span class="rule"></span>
        <a href="/projects" class="chapter-link">The full armoury ({projects.length}) ↗</a>
      </header>

      <ProjectIndex projects={featured} />
    </div>
  </section>

  <!-- ════ INTERLUDE — TONGUES ══════════════════════════════ -->
  <section class="tongues bleed" aria-label="Languages">
    <div class="tongues-sheet">
      <div class="wrap tongues-inner">
        <div class="tg-left">
          <span class="tg-label">[ Interlude — Tongues ]</span>

          <div class="tg-stack" data-tongues>
            {tongues.map(t => (
              <span class="tongue">
                <span class="tg-word">{t.word}</span>
                <span class="tg-lang">{t.lang}</span>
              </span>
            ))}
          </div>

          <p class="tg-copy">
            Eight tongues, five scripts, two mother languages. I take meetings in
            English and Spanish, hold my own in Mandarin, and read a half-dozen more.
            Global teams and international users feel like home, not like overhead.
          </p>
        </div>

        <ul class="tg-table">
          {profile.languages.map(l => (
            <li>
              <span class="tg-name">{l.name}</span>
              <span class="tg-dots" aria-hidden="true"></span>
              <span class="tg-level">{l.level}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ════ CHAPTER III — CHRONICLES ═════════════════════════ -->
  {posts.length > 0 && (
    <section class="act">
      <div class="wrap">
        <header class="chapter" data-reveal="rise">
          <span class="numeral">III</span>
          <h2 class="chapter-title">Chronicles</h2>
          <span class="rule"></span>
          <a href="/blog" class="chapter-link">All entries ↗</a>
        </header>

        <div class="entries">
          {posts.map((post, i) => <BlogCard post={post} index={i} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ════ SEND WORD ════════════════════════════════════════ -->
  <section class="summon">
    <div class="wrap summon-inner">
      <span class="label label-brass" data-reveal="rise">[ The road continues ]</span>
      <a href="/contact" class="summon-cta" data-reveal="rise" style="--d:100ms">
        <span class="summon-line">Send</span>
        <span class="summon-line summon-line-2">Word<span class="summon-arrow" aria-hidden="true">→</span></span>
      </a>
      <p class="summon-note" data-reveal="rise" style="--d:200ms">
        Open to AI engineering roles, freelance projects, and stubborn problems.
        Reply usually within a day.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  /* ════ HERO ═══════════════════════════════════════════════ */
  .hero {
    position: relative;
    padding-block: clamp(48px, 9vh, 96px) clamp(56px, 8vh, 88px);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-inner { position: relative; z-index: 2; }

  /* ── The black sun ─────────────────────────── */
  .eclipse {
    position: absolute;
    z-index: 0;
    top: -26%;
    right: -12%;
    width: min(760px, 82vw);
    aspect-ratio: 1;
    pointer-events: none;
    transform: translate3d(calc(var(--mx, 0) * -26px), calc(var(--my, 0) * -20px), 0);
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .eclipse > span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  .ecl-ring {
    background: radial-gradient(
      circle,
      transparent 39%,
      rgba(147, 23, 27, 0.42) 46%,
      rgba(207, 53, 32, 0.14) 53%,
      transparent 64%
    );
    filter: blur(6px);
    animation: eclPulse 7s ease-in-out infinite;
  }

  .ecl-vortex {
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      rgba(207, 53, 32, 0.5) 38deg,
      transparent 85deg,
      rgba(147, 23, 27, 0.4) 130deg,
      transparent 185deg,
      rgba(207, 53, 32, 0.42) 235deg,
      transparent 290deg,
      rgba(200, 162, 74, 0.22) 330deg,
      transparent 360deg
    );
    -webkit-mask: radial-gradient(circle, transparent 37%, #000 45%, #000 57%, transparent 66%);
            mask: radial-gradient(circle, transparent 37%, #000 45%, #000 57%, transparent 66%);
    filter: blur(8px);
    animation: eclSpin 46s linear infinite;
  }

  .ecl-core {
    inset: 26%;
    background: radial-gradient(circle at 36% 30%, #1e120e 0%, #0d0906 48%, #000 78%);
    box-shadow:
      0 0 30px 6px rgba(147, 23, 27, 0.38),
      0 0 110px 26px rgba(147, 23, 27, 0.14),
      inset -18px -22px 46px rgba(0, 0, 0, 0.92),
      inset 8px 10px 28px rgba(207, 53, 32, 0.2);
    animation: eclThrob 7s ease-in-out infinite;
  }

  @keyframes eclPulse {
    0%, 100% { opacity: 0.72; transform: scale(1); }
    50%      { opacity: 1;    transform: scale(1.03); }
  }
  @keyframes eclSpin { to { transform: rotate(360deg); } }
  @keyframes eclThrob {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.04); }
  }

  /* ── Chapter cap ───────────────────────────── */
  .chapter-cap {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: clamp(30px, 6vh, 60px);
  }

  .chapter-cap .label { white-space: nowrap; }

  /* ── The name, lit by the eclipse ──────────── */
  .name {
    font-family: var(--display);
    font-weight: 900;
    font-size: var(--t-hero);
    line-height: 0.86;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .name-line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em;
  }

  .name-line-2 { padding-left: 0.09em; }

  .name-in {
    display: block;
    background: linear-gradient(
      104deg,
      var(--bone) 42%,
      #d78a68 66%,
      var(--blood-hi) 92%
    );
    -webkit-background-clip: text;
            background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  /* ── Hero foot ─────────────────────────────── */
  .hero-foot {
    display: grid;
    grid-template-columns: 0.85fr 1.25fr 0.7fr;
    gap: clamp(24px, 4vw, 56px);
    padding-top: clamp(40px, 7vh, 72px);
    border-top: 1px solid var(--line);
    margin-top: clamp(32px, 5vh, 56px);
  }

  .hf-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hf-role {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .hf-sub {
    font-size: var(--t-sm);
    color: var(--ash);
    line-height: 1.55;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green);
    margin-top: 6px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 20%, transparent);
    animation: pulse 2.6s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.28; }
  }

  .hf-lede p {
    font-size: var(--t-md);
    line-height: 1.8;
    color: var(--bone);
    max-width: 46ch;
  }

  .hf-quote {
    font-style: italic;
    color: var(--ash) !important;
    font-size: var(--t-sm) !important;
    border-left: 1px solid var(--blood);
    padding-left: 16px;
    margin-top: 4px;
  }

  .hf-cite {
    display: block;
    font-family: var(--mono);
    font-style: normal;
    font-size: var(--t-micro);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--brass-dim);
    margin-top: 8px;
  }

  .hf-links { gap: 4px; }

  .way {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ash);
    transition: color 240ms, padding-left 300ms var(--ease), border-color 240ms;
  }

  .way:hover {
    color: var(--bone);
    padding-left: 8px;
    border-color: var(--blood);
  }

  .way-lead { color: var(--brass); }

  /* A shortcut, not a peer of the links above it */
  .way-quiet {
    color: var(--ash);
    border-bottom-color: transparent;
    font-size: var(--t-micro);
  }

  .way-quiet:hover { color: var(--bone); }

  /* ── Descend cue ───────────────────────────── */
  .descend {
    position: absolute;
    right: clamp(20px, 5vw, 64px);
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    z-index: 2;
  }

  .descend-text {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ash-dim);
    writing-mode: vertical-rl;
  }

  .descend-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(180deg, var(--line), var(--blood));
    transform-origin: top center;
    animation: descend 2.4s ease-in-out infinite;
  }

  @keyframes descend {
    0%       { transform: scaleY(0); opacity: 0; }
    40%      { transform: scaleY(1); opacity: 1; }
    100%     { transform: scaleY(1); opacity: 0; }
  }

  @media (max-width: 980px) {
    .hero-foot { grid-template-columns: 1fr 1fr; }
    .hf-links { grid-column: 1 / -1; }
    .descend { display: none; }
  }

  @media (max-width: 640px) {
    .hero-foot { grid-template-columns: 1fr; gap: 34px; }
    .eclipse { top: -6%; right: -28%; width: 108vw; opacity: 0.8; }
    .chapter-cap { gap: 10px; }
    .chapter-cap .label:last-child { display: none; }
  }

  /* ════ ACTS ═══════════════════════════════════════════════ */
  .act {
    padding-block: clamp(56px, 9vw, 110px);
    border-bottom: 1px solid var(--line);
    position: relative;
  }

  .entries { border-top: 1px solid var(--line); }

  /* ════ TONGUES — the pasted-in page ═══════════════════════ */
  .tongues {
    padding-block: clamp(50px, 8vw, 96px);
    border-bottom: 1px solid var(--line);
  }

  .tongues-sheet {
    background: var(--paper);
    color: var(--paper-ink);
    width: 103%;
    margin-left: -1.5%;
    transform: rotate(-0.5deg);
    padding-block: clamp(40px, 6vw, 72px);
    box-shadow:
      0 0 0 1px var(--pitch),
      0 22px 60px rgba(0, 0, 0, 0.5);
    position: relative;
    overflow: hidden;
    transition: background-color 700ms var(--ease);
  }

  /* screentone in the corner, like a printed page */
  .tongues-sheet::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 42%;
    height: 100%;
    pointer-events: none;
    opacity: 0.5;
    background-image: radial-gradient(circle, rgba(20, 17, 12, 0.5) 1px, transparent 1px);
    background-size: 7px 7px;
    -webkit-mask-image: linear-gradient(105deg, transparent 35%, #000 100%);
            mask-image: linear-gradient(105deg, transparent 35%, #000 100%);
  }

  .tongues-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
    transform: rotate(0.5deg);
  }

  .tg-label {
    display: block;
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #7a5a24;
    margin-bottom: 22px;
  }

  /* ── The cycler ────────────────────────────── */
  .tg-stack {
    display: grid;
    min-height: clamp(4.2rem, 11vw, 8rem);
    margin-bottom: 26px;
  }

  .tongue {
    grid-area: 1 / 1;
    display: flex;
    align-items: baseline;
    gap: clamp(12px, 2vw, 22px);
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 520ms var(--ease), transform 520ms var(--ease);
    pointer-events: none;
  }

  .tongue.on { opacity: 1; transform: none; }

  .tg-word {
    font-family: var(--display), var(--han);
    font-weight: 900;
    font-size: clamp(2.6rem, 8.5vw, 6rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--paper-ink);
  }

  .tg-lang {
    font-family: var(--mono);
    font-size: var(--t-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8a2f22;
    white-space: nowrap;
  }

  .tg-copy {
    font-size: var(--t-md);
    line-height: 1.8;
    color: #3b3227;
    max-width: 52ch;
  }

  /* ── The printed table ─────────────────────── */
  .tg-table {
    border-top: 1px solid rgba(20, 17, 12, 0.35);
    padding-top: 4px;
  }

  .tg-table li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 7px 0;
    font-family: var(--mono);
    font-size: var(--t-xs);
  }

  .tg-name { color: var(--paper-ink); letter-spacing: 0.06em; }

  .tg-dots {
    flex: 1;
    height: 1px;
    background-image: radial-gradient(circle, rgba(20, 17, 12, 0.45) 0.5px, transparent 0.5px);
    background-size: 4px 1px;
    transform: translateY(-3px);
  }

  .tg-level {
    color: #6b3a1e;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: var(--t-micro);
  }

  @media (max-width: 760px) {
    .tongues-inner { grid-template-columns: 1fr; }
    .tongues-sheet::after { display: none; }
  }

  /* ════ SUMMON ═════════════════════════════════════════════ */
  .summon {
    padding-block: clamp(64px, 11vw, 132px);
  }

  .summon-inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .summon-cta {
    font-family: var(--display);
    font-weight: 900;
    font-size: var(--t-xxl);
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    width: fit-content;
  }

  .summon-line { display: block; transition: transform 460ms var(--ease), color 300ms; }
  .summon-line-2 { padding-left: 0.5em; }

  .summon-cta:hover .summon-line   { transform: translateX(14px); color: var(--blood-hi); }
  .summon-cta:hover .summon-line-2 { transform: translateX(30px); }

  .summon-arrow {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.4em;
    vertical-align: middle;
    margin-left: 0.5em;
    color: var(--brass);
    transition: transform 460ms var(--ease);
  }

  .summon-cta:hover .summon-arrow { transform: translateX(14px); }

  .summon-note {
    font-size: var(--t-sm);
    color: var(--ash);
    max-width: 40ch;
  }
</style>
