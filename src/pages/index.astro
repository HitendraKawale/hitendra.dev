---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BlogCard from "../components/BlogCard.astro";
import CastleScene from "../components/CastleScene.astro";
import { projects } from "../data/projects";
import { profile } from "../data/profile";
import { getCollection } from "astro:content";
const featured = projects.filter(project => project.featured).slice(0, 3);
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .filter(post => post.id === "saga-scribble-segmentation");
---
<BaseLayout title={`${profile.name} | ${profile.title}`} description={profile.bio} cardDescription={profile.cardBio}>
  <section class="intro castle-hero section">
    <div class="intro-inner wrap">
      <div class="intro-main">
        <p class="intro-name">{profile.name}</p>
        <h1>I build AI systems that hold up outside the demo.</h1>
      </div>
      <div class="intro-aside">
        <p class="qualification">MSc Artificial Intelligence, University of Surrey. I focus on backend systems, evaluation, and deployment.</p>
        <p class="focus">LLM systems, retrieval, and 3D vision.</p>
        <p class="availability">{profile.availability}</p>
        <div class="actions">
          <a class="button" href={profile.resume} download="Hitendra-Kawale-Resume.pdf">Resume</a>
          <a href={profile.github}>GitHub</a>
          <a href="/contact">Contact</a>
        </div>
      </div>
    </div>
    <CastleScene variant="hero" />
  </section>
  <section class="section" aria-labelledby="work-title">
    <header class="section-head"><h2 id="work-title">Selected work</h2><a href="/projects">All projects ({projects.length})</a></header>
    {featured.map(project => <ProjectCard project={project} expanded />)}
    {featured.length === 0 && <p class="muted">Projects will appear here as they are published.</p>}
  </section>
  {posts.length > 0 && (
    <section class="section" aria-labelledby="writing-title">
      <header class="section-head"><h2 id="writing-title">Selected writing</h2><a href="/blog">All writing</a></header>
      {posts.map(post => <BlogCard post={post} />)}
    </section>
  )}
  <section class="section about" aria-labelledby="about-title">
    <h2 id="about-title">About</h2>
    <div>
      <p>I'm Hitendra, an AI engineer based in the United Kingdom. My work spans LLM infrastructure, retrieval systems, and interactive 3D vision. For my MSc at the University of Surrey, I built scribble-guided segmentation tools for 3D Gaussian scenes.</p>
      <p>I also enjoy learning languages. I work in English and Spanish, speak conversational Mandarin, and grew up speaking Hindi and Marathi.</p>
      <dl class="languages" aria-label="Languages and proficiency">
        {profile.languages.map(language => <div><dt>{language.name}</dt><dd>{language.level}</dd></div>)}
      </dl>
      <p class="muted">Alongside full-time AI roles, I'm open to scoped freelance work and research collaborations. <a href="/contact">Get in touch</a>.</p>
    </div>
  </section>
</BaseLayout>
<style>
  .intro { position: relative; width: 100vw; margin-inline: calc(50% - 50vw); padding: 0; background: var(--castle-sky); overflow: hidden; }
  .intro-inner { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: center; min-height: calc(100svh - 92px); padding-block: 56px; }
  .intro-main, .intro-aside { max-width: 52%; }
  .intro-name { margin-bottom: 24px; color: var(--accent-hi); font-size: .9375rem; }
  h1 { max-width: 11ch; font-size: clamp(3rem, 6vw, 5.5rem); line-height: 1.02; letter-spacing: -.065em; }
  .intro-aside { margin-top: 28px; }
  .qualification { color: var(--text); font-size: 1.125rem; line-height: 1.5; }
  .focus { margin-top: 14px; color: var(--text); }
  .availability { margin-top: 20px; color: var(--accent-hi); font-size: .875rem; }
  .intro a { color: var(--accent-hi); }
  .intro .button { border-color: var(--accent-hi); }
  .intro :global(.castle-scene) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .about { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 24px; }
  .about p + p { margin-top: 20px; }
  .languages { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 28px; margin-block: 28px; font-size: .875rem; }
  .languages div { display: flex; flex-wrap: wrap; gap: 4px 12px; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
  dd { margin: 0; color: var(--muted); }
  @media (max-width: 760px) { .intro-main, .intro-aside { max-width: 58%; } h1 { max-width: 13ch; } }
  @media (max-width: 640px) {
    .intro-inner { min-height: auto; padding-block: 48px 0; }
    .intro-main, .intro-aside { max-width: none; }
    .intro-name { margin-bottom: 16px; }
    .availability { margin-top: 16px; }
    .focus { margin-top: 12px; }
    .intro :global(.castle-scene) { position: relative; width: 100%; height: 210px; margin-top: 20px; }
    .about { grid-template-columns: 1fr; }
    .languages { grid-template-columns: 1fr; }
  }
  @media (max-width: 360px) {
    .intro-inner { padding-top: 32px; }
    h1 { font-size: 2.65rem; }
    .intro-aside { margin-top: 20px; }
    .intro :global(.castle-scene) { margin-top: 12px; }
  }
</style>
