---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
---
<BaseLayout title={`Contact | ${profile.name}`} description="Contact Hitendra Kawale about AI engineering roles, research collaborations, or scoped freelance projects.">
  <header class="page-head"><h1>Let's work together.</h1><p>I'm open to AI engineering roles, especially work involving LLM systems, retrieval, evaluation, and deployment.</p></header>
  <section class="section" aria-labelledby="email-title">
    <h2 id="email-title">Email</h2>
    <div class="actions">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <button type="button" data-copy={profile.email} hidden>Copy email</button>
      <span class="copy-status" role="status"></span>
    </div>
    <p class="muted">Share the role or problem you're working on and how I can help.</p>
  </section>
  <section class="section" aria-labelledby="links-title">
    <h2 id="links-title">Resume and profiles</h2>
    <div class="actions">
      <a class="button" href={profile.resume} download="Hitendra-Kawale-Resume.pdf">Download resume</a>
      <a href={profile.github}>GitHub</a>
      {profile.linkedin && <a href={profile.linkedin}>LinkedIn</a>}
      {profile.codeberg && <a href={profile.codeberg}>Codeberg</a>}
    </div>
  </section>
  <section class="section" aria-labelledby="collaboration-title">
    <h2 id="collaboration-title">Other ways to collaborate</h2>
    <p class="collaboration">I'm also open to scoped freelance projects and research collaborations in AI systems and 3D vision. Based in the United Kingdom, working in English and Spanish.</p>
  </section>
</BaseLayout>
<style>
  .collaboration { max-width: 64ch; margin-top: 20px; color: var(--muted); }
  .copy-status { flex-basis: 100%; margin-top: 0; }
</style>
