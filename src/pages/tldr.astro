---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";
const featured = projects.filter(project => project.featured).slice(0, 3);
---
<BaseLayout title={`Quick profile | ${profile.name}`} description={profile.cardBio}>
  <header class="page-head"><p class="meta">Quick profile</p><h1>{profile.name}</h1><p>{profile.bio}</p></header>
  <section class="section" aria-labelledby="overview-title">
    <h2 id="overview-title">At a glance</h2>
    <dl>
      <div><dt>Role</dt><dd>{profile.title}</dd></div>
      <div><dt>Education</dt><dd>MSc Artificial Intelligence, University of Surrey</dd></div>
      <div><dt>Location</dt><dd>United Kingdom</dd></div>
      <div><dt>Availability</dt><dd>{profile.availability}</dd></div>
    </dl>
  </section>
  <section class="section" aria-labelledby="work-title">
    <header class="section-head"><h2 id="work-title">Selected work</h2><a href="/projects">All projects ({projects.length})</a></header>
    <ul class="work">{featured.map(project => <li><h3>{project.href ? <a href={project.href}>{project.title}</a> : project.title}</h3><p class="muted">{project.subtitle}</p></li>)}</ul>
  </section>
  <section class="section" aria-labelledby="contact-title">
    <h2 id="contact-title">Contact and links</h2>
    <div class="actions">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <button type="button" data-copy={profile.email} hidden>Copy email</button>
      <span class="copy-status" role="status"></span>
    </div>
    <div class="actions">
      <a href={profile.resume} download="Hitendra-Kawale-Resume.pdf">Resume</a>
      <a href={profile.github}>GitHub</a>
      {profile.linkedin && <a href={profile.linkedin}>LinkedIn</a>}
      {profile.codeberg && <a href={profile.codeberg}>Codeberg</a>}
    </div>
  </section>
</BaseLayout>
<style>
  .page-head .meta { margin: 0 0 12px; }
  dl { margin-top: 20px; }
  dl div { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 12px; padding-block: 12px; border-bottom: 1px solid var(--border); }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .work { list-style: none; padding: 0; }
  .work li { padding-block: 20px; border-top: 1px solid var(--border); }
  .work a { display: inline-flex; min-height: 44px; align-items: center; }
  .copy-status { flex-basis: 100%; }
  @media (max-width: 480px) { dl div { grid-template-columns: 1fr; gap: 4px; } }
</style>
