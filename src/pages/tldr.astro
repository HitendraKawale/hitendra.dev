---
// TL;DR — the whole site on one screen, laid out as a document rather
// than a list. Deliberately does NOT use BaseLayout: no nav, no spine,
// no ash, no marquee. A sticky identity column, a ruled record, and one
// blood accent. Shares the tokens, so a saved Eclipse still applies.
import "../styles/global.css";
import Brand from "../components/Brand.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";

const featured = projects.filter(p => p.featured);

const facts = [
  ["Discipline", "AI Engineer — audio & NLP, LLM platforms, RAG, 3D vision"],
  ["Study",      "MSc Artificial Intelligence, University of Surrey"],
  ["Based",      "United Kingdom — GMT/BST"],
  ["Tongues",    "English · Español · 中文 · हिंदी · मराठी +3"],
];

const links = [
  ["Email",    profile.email,                     `mailto:${profile.email}`],
  ["GitHub",   "github.com/HitendraKawale",       profile.github],
  ["Codeberg", "codeberg.org/HitendraKawale",     profile.codeberg],
  ["LinkedIn", "linkedin.com/in/hitendra-kawale", profile.linkedin],
  ["Resume",   "resume.pdf",                      profile.resume],
];

const year = new Date().getFullYear();

// This page owns its <head>, so it declares its own canonical
// rather than inheriting BaseLayout's.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Hitendra Kawale in one screen — AI engineer working in audio & NLP, LLM platforms, and RAG pipelines." />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content="TL;DR — Hitendra Kawale" />
    <meta
      property="og:description"
      content="Hitendra Kawale in one screen — AI engineer working in audio & NLP, LLM platforms, and RAG pipelines."
    />
    <meta property="og:site_name" content="Hitendra Kawale" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>TL;DR — Hitendra Kawale</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,700..900&family=Spectral:wght@300;400&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@900&text=%E6%B3%BD%E8%B4%A4&display=swap"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        if (localStorage.getItem("eclipse") === "1")
          document.documentElement.setAttribute("data-eclipse", "");
      } catch (e) {}
    </script>
  </head>

  <body class="tldr">
    <div class="sheet">

      <header class="topbar">
        <span>TL;DR</span>
        <span class="topbar-mid">The short version</span>
        <span class="clock" id="clock" title="My local time">
          <span class="clock-time">--:--</span> London
        </span>
      </header>

      <div class="grid">

        <aside class="ident">
          <div class="ident-inner">
            <Brand size={17} />

            <h1>Hitendra<br />Kawale</h1>
            <span class="han">泽贤</span>

            <p class="lede">
              I build production-grade AI systems. Backend-heavy,
              deployment-aware, and measured rather than estimated.
            </p>

            <span class="status">
              <span class="dot"></span>Open to roles &amp; freelance
            </span>
          </div>
        </aside>

        <main class="record">

          <section>
            <h2><span class="n">01</span>At a glance</h2>
            <dl class="facts">
              {facts.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          </section>

          <section>
            <h2><span class="n">02</span>Selected work</h2>
            <ol class="work">
              {featured.map((p, i) => (
                <li>
                  <a href={p.href} target="_blank" rel="noreferrer">
                    <span class="w-i">{String(i + 1).padStart(2, "0")}</span>
                    <span class="w-main">
                      <span class="w-title">{p.title}</span>
                      <span class="w-sub">{p.subtitle}</span>
                    </span>
                    <span class="w-go" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ol>
            <a class="more" href="/projects">All eight projects →</a>
          </section>

          <section>
            <h2><span class="n">03</span>Elsewhere</h2>
            <ul class="links">
              {links.filter(([, , href]) => href).map(([k, v, href]) => (
                <li>
                  <span class="k">{k}</span>
                  <span class="v">
                    <a href={href}>{v}</a>
                    {k === "Email" && (
                      <button class="copy" data-copy={profile.email} type="button">copy</button>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </section>

        </main>
      </div>

      <footer class="foot">
        <a href="/" class="back">The full chronicle →</a>
        <span class="foot-note">Struggle, endure, contend.</span>
      </footer>

    </div>

    <script>
      /* His local time, so a reader knows whether he's awake */
      const clock = document.getElementById("clock");
      if (clock) {
        const face = clock.querySelector(".clock-time")!;
        const fmt = new Intl.DateTimeFormat("en-GB", {
          timeZone: "Europe/London",
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
        });
        const tick = () => { face.textContent = fmt.format(new Date()); };
        tick();
        setInterval(tick, 15000);
      }

      /* Copy the address without leaving the page */
      document.querySelectorAll<HTMLButtonElement>(".copy").forEach(btn => {
        btn.addEventListener("click", async () => {
          const value = btn.dataset.copy;
          if (!value) return;
          try {
            await navigator.clipboard.writeText(value);
            btn.textContent = "copied";
            btn.classList.add("done");
          } catch {
            btn.textContent = "press ⌘C";
          }
          setTimeout(() => {
            btn.textContent = "copy";
            btn.classList.remove("done");
          }, 1600);
        });
      });
    </script>
  </body>
</html>

<style>
  /* Strip the shared shell back to nothing */
  .tldr {
    display: block;
    background: var(--void);
    padding: clamp(24px, 5vw, 56px);
  }

  .tldr::before, .tldr::after { display: none; }

  .sheet {
    max-width: 64rem;
    margin-inline: auto;
    font-family: var(--body);
    font-weight: 300;
    color: var(--ash);
  }

  /* ── Top bar: reads as a document header ── */
  .topbar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ash-dim);
  }

  .topbar span:first-child { color: var(--brass); }
  .topbar-mid { display: none; }

  @media (min-width: 720px) {
    .topbar-mid { display: block; letter-spacing: 0.2em; }
  }

  /* ── The two columns ── */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(36px, 5vw, 64px);
    padding-block: clamp(40px, 7vw, 76px);
  }

  @media (min-width: 860px) {
    .grid { grid-template-columns: 0.85fr 1.35fr; }
    .ident-inner { position: sticky; top: clamp(24px, 5vw, 56px); }
  }

  /* ── Identity column ── */
  h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--bone);
    margin-top: 20px;
  }

  .han {
    display: block;
    font-family: var(--han);
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    color: var(--ash-dim);
    margin-top: 12px;
  }

  .lede {
    font-size: 0.9rem;
    line-height: 1.7;
    margin-top: 22px;
    max-width: 30ch;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green);
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    animation: blip 2.6s ease-in-out infinite;
  }

  @keyframes blip { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  /* ── Record column ── */
  .record section + section { margin-top: clamp(36px, 5vw, 54px); }

  h2 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--bone);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .n { color: var(--brass); }

  /* Facts */
  .facts > div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ash-dim);
    padding-top: 3px;
  }

  dd {
    color: var(--bone);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* Work */
  .work li { border-bottom: 1px solid var(--line); }

  .work a {
    display: grid;
    grid-template-columns: 2.4rem 1fr auto;
    align-items: baseline;
    gap: 14px;
    padding: 14px 0;
    transition: padding-left 300ms var(--ease);
  }

  .work a:hover { padding-left: 8px; }

  .w-i {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--brass-dim);
  }

  .w-title {
    display: block;
    font-size: 1rem;
    color: var(--bone);
    transition: color 180ms;
  }

  .work a:hover .w-title { color: var(--blood-hi); }

  .w-sub {
    display: block;
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--ash-dim);
    margin-top: 5px;
    line-height: 1.5;
  }

  .w-go {
    color: var(--ash-dim);
    font-size: 0.8rem;
    transition: transform 260ms var(--ease), color 180ms;
  }

  .work a:hover .w-go { color: var(--blood-hi); transform: translate(2px, -2px); }

  .more {
    display: inline-block;
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ash-dim);
    transition: color 180ms;
  }

  .more:hover { color: var(--brass); }

  /* Links */
  .links li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
  }

  .k {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ash-dim);
    padding-top: 3px;
  }

  .links a {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--blood-hi);
    width: fit-content;
    border-bottom: 1px solid transparent;
    transition: border-color 180ms;
    word-break: break-all;
  }

  .links a:hover { border-bottom-color: currentColor; }

  .v { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }

  /* Copy button — only announces itself on approach */
  .copy {
    font-family: var(--mono);
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ash-dim);
    border: 1px solid var(--line);
    padding: 2px 7px;
    opacity: 0;
    transition: opacity 200ms, color 200ms, border-color 200ms;
  }

  .links li:hover .copy,
  .copy:focus-visible { opacity: 1; }

  .copy:hover { color: var(--bone); border-color: var(--ash-dim); }
  .copy.done { color: var(--green); border-color: var(--green); opacity: 1; }

  /* ── Clock ── */
  .clock { color: var(--ash-dim); white-space: nowrap; }
  .clock-time { color: var(--brass); font-variant-numeric: tabular-nums; }

  /* ── Foot ── */
  .foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .back { color: var(--ash); transition: color 180ms; }
  .back:hover { color: var(--brass); }
  .foot-note { color: var(--ash-dim); font-style: normal; }

  @media (max-width: 560px) {
    .facts > div, .links li { grid-template-columns: 1fr; gap: 3px; }
    .work a { grid-template-columns: 1.8rem 1fr auto; }
  }

  /* ── The page settles in once, then stays put ── */
  .topbar, .ident, .record section, .foot {
    animation: settle 620ms var(--ease) backwards;
  }

  .ident           { animation-delay: 60ms; }
  .record section:nth-of-type(1) { animation-delay: 130ms; }
  .record section:nth-of-type(2) { animation-delay: 190ms; }
  .record section:nth-of-type(3) { animation-delay: 250ms; }
  .foot            { animation-delay: 310ms; }

  @keyframes settle {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .topbar, .ident, .record section, .foot { animation: none; }
    .dot { animation: none; }
  }

  /* ── Prints as a clean one-pager ── */
  @media print {
    .tldr { background: #fff; padding: 0; }
    .sheet, .lede, dd, .w-title { color: #000; }
    .topbar, h2, dt, .k, .w-i, .w-sub, .foot { color: #444; }
    .ident-inner { position: static; }
    .grid { padding-block: 18pt; }
    .copy, .clock, .back, .more, .w-go { display: none; }
    .links a, .work a { color: #000; }
    .links a::after { content: ""; }
    .topbar, .foot, h2, .facts > div, .links li, .work li {
      border-color: #ccc;
    }
    a { text-decoration: none; }
  }
</style>
