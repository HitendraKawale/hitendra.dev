---
import { profile } from "../data/profile";
---
<footer>
  <div class="wrap footer-inner">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <ul aria-label="Elsewhere">
      <li><a href={`mailto:${profile.email}`}>Email</a></li>
      <li><a href={profile.github}>GitHub</a></li>
      {profile.codeberg && <li><a href={profile.codeberg}>Codeberg</a></li>}
      {profile.linkedin && <li><a href={profile.linkedin}>LinkedIn</a></li>}
      <li><a href="/tldr">Quick profile</a></li>
      <li><a href={profile.archive}>Previous design</a></li>
    </ul>
  </div>
</footer>
<style>
  footer { border-top: 1px solid var(--border); color: var(--muted); font-size: .875rem; }
  .footer-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; padding-block: 24px; }
  ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 20px; }
  a { min-height: 44px; display: inline-flex; align-items: center; }
</style>
