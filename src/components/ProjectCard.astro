---
import type { Project } from "../data/projects";
interface Props { project: Project; expanded?: boolean; }
const { project, expanded = false } = Astro.props;
---
<article class="project" data-project>
  <header>
    <h3>{project.title}</h3>
    <span class="meta">{project.status}</span>
  </header>
  <p class="subtitle">{project.subtitle}</p>
  <ul class="stack" aria-label="Technologies">{project.stack.map(item => <li>{item}</li>)}</ul>
  {expanded ? <p class="description">{project.description}</p> : (
    <details>
      <summary>Details <span class="sr-only">for {project.title}</span></summary>
      <p class="description">{project.description}</p>
    </details>
  )}
  {project.href && <a class="source" href={project.href}>View project<span class="sr-only">: {project.title}</span></a>}
</article>
<style>
  .project { padding-block: 28px; border-top: 1px solid var(--border); }
  header { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px 20px; }
  .subtitle { margin-top: 8px; color: var(--muted); }
  .stack { margin-top: 12px; }
  .description { margin-top: 16px; max-width: 78ch; }
  details { margin-top: 12px; }
  summary { cursor: pointer; color: var(--accent); min-height: 44px; padding-block: 8px; width: fit-content; }
  .source { display: inline-flex; align-items: center; min-height: 44px; margin-top: 8px; font-size: .875rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
