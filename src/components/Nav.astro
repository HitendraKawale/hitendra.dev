---
import { profile } from "../data/profile";
const links = [
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Writing" },
  { href: "/contact", label: "Contact" },
];
const path = Astro.url.pathname.replace(/\/$/, "");
---
<header>
  <nav class="wrap" aria-label="Primary">
    <a class="identity" href="/" aria-current={path === "" ? "page" : undefined}>{profile.name}<span class="han" lang="zh-Hans">{profile.nameHan}</span></a>
    <ul>
      {links.map(link => (
        <li><a href={link.href} aria-current={path === link.href ? "page" : path.startsWith(`${link.href}/`) ? "location" : undefined}>{link.label}</a></li>
      ))}
    </ul>
    <button type="button" data-theme-toggle aria-pressed="false" hidden>Dark mode</button>
  </nav>
</header>
<style>
  header { border-bottom: 1px solid var(--border); }
  nav { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 36px; padding-block: 24px; }
  .identity { color: var(--text); font-weight: 700; letter-spacing: -.045em; margin-right: auto; gap: 10px; font-size: 1.0625rem; }
  .identity .han { color: var(--muted); font-size: .9375rem; font-weight: 400; letter-spacing: .06em; }
  a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  ul { display: flex; gap: 30px; list-style: none; padding: 0; font-size: .875rem; }
  ul a { color: var(--muted); }
  ul a:hover, [aria-current] { color: var(--accent); text-decoration: underline; }
  button { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 600px) {
    nav { gap: 4px 12px; padding-block: 12px; }
    ul { order: 3; width: 100%; gap: 28px; }
    .identity { gap: 8px; }
  }
</style>
