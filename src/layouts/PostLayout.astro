---
import BaseLayout from "./BaseLayout.astro";
interface Adjacent { title: string; slug: string; }
interface Props {
  frontmatter: { title: string; description: string; date: Date; tags?: string[]; };
  minutes?: number;
  prev?: Adjacent | null;
  next?: Adjacent | null;
}
const { frontmatter, minutes = 1, prev = null, next = null } = Astro.props;
const formatted = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(frontmatter.date);
---
<BaseLayout title={`${frontmatter.title} | Hitendra Kawale`} description={frontmatter.description}>
  <article class="post section">
    <header>
      <a class="back" href="/blog">All writing</a>
      <h1>{frontmatter.title}</h1>
      <p class="description">{frontmatter.description}</p>
      <div class="post-meta meta"><time datetime={frontmatter.date.toISOString()}>{formatted}</time><span>{minutes} min read</span></div>
      {frontmatter.tags && <ul class="stack">{frontmatter.tags.map(tag => <li>{tag}</li>)}</ul>}
    </header>
    <div class="prose"><slot /></div>
    {(prev || next) && <nav class="adjacent" aria-label="More writing">
      {prev && <a href={`/blog/${prev.slug}`}><span class="meta">Previous</span>{prev.title}</a>}
      {next && <a href={`/blog/${next.slug}`}><span class="meta">Next</span>{next.title}</a>}
    </nav>}
  </article>
</BaseLayout>
<style>
  .post { max-width: 68ch; margin-inline: auto; }
  .back { display: inline-flex; min-height: 44px; align-items: center; margin-bottom: 16px; font-size: .875rem; }
  h1 { font-size: clamp(2rem, 4vw, 2.75rem); max-width: none; }
  .description { margin-top: 24px; color: var(--muted); font-size: 1.125rem; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-block: 24px 12px; }
  .prose { margin-top: 40px; font-size: 1.0625rem; overflow-wrap: anywhere; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin-bottom: 24px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 24px; }
  .prose :global(li + li) { margin-top: 8px; }
  .prose :global(h2) { margin-block: 48px 20px; }
  .prose :global(h3) { margin-block: 32px 16px; }
  .prose :global(blockquote) { margin: 28px 0; padding-left: 24px; border-left: 2px solid var(--accent); color: var(--muted); }
  .prose :global(code) { font-family: var(--mono); font-size: .875em; background: var(--surface-2); padding: 2px 5px; border-radius: 3px; }
  .prose :global(pre) { max-width: 100%; overflow-x: auto; padding: 20px; border: 1px solid var(--border); border-radius: 5px; margin-block: 24px; }
  .prose :global(pre code) { background: transparent; padding: 0; }
  .prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin-block: 24px; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 10px 16px; border: 1px solid var(--border); }
  .prose :global(img) { margin-block: 24px; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--border); margin-block: 40px; }
  .adjacent { border-top: 1px solid var(--border); margin-top: 48px; padding-top: 24px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .adjacent a { display: flex; flex-direction: column; gap: 8px; min-height: 44px; }
  @media (max-width: 600px) { .adjacent { grid-template-columns: 1fr; } }
</style>
